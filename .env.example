# ===================================================
# CivicAI - Environment Configuration
# ===================================================

# Google Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Maps Platform (Optional for live satellite maps)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Gemini API Key (For client-side or proxy AI analysis)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Demo Mode toggle ('true' forces demo mode with full seed data)
VITE_USE_DEMO_MODE=true
